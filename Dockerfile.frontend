# =============================================================================
# DigiID — Frontend Dockerfile (Optimisé pour espace disque minimal)
# =============================================================================
FROM node:20-alpine AS builder
WORKDIR /app

# 1. Copier les fichiers de dépendances en premier (optimisation du cache Docker)
COPY frontend/package.json frontend/package-lock.json* ./

# 2. Installer TOUTES les dépendances (prod + dev) nécessaires au build
RUN npm install

# 3. Copier le reste du code source
COPY frontend/ .

# 4. Patch du bug Next.js 14.2.x "Cannot read properties of undefined (reading 'os')"
RUN if [ -f node_modules/next/dist/lib/patch-incorrect-lockfile.js ]; then \
      printf 'async function patchIncorrectLockfile(){}\nmodule.exports={patchIncorrectLockfile}\n' > node_modules/next/dist/lib/patch-incorrect-lockfile.js; \
    fi

# 5. Variables d'environnement de build
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_URL_BACKEND
ENV NEXT_PUBLIC_URL_BACKEND=${NEXT_PUBLIC_URL_BACKEND}

# 6. Build production (génère le dossier .next/standalone)
RUN npm run build

# =============================================================================
# Étape finale — image ultra-légère de production
# =============================================================================
FROM node:20-alpine AS coureur
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Créer un utilisateur non-root pour la sécurité
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 digiid

# ⚠️ CORRECTION MAJEURE : Ne PAS copier le node_modules du builder.
# On installe UNIQUEMENT les dépendances de production (beaucoup plus léger)
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --omit=dev --no-save

# Copier UNIQUEMENT les fichiers générés par le build en mode standalone
COPY --from=builder --chown=digiid:nodejs /app/public ./public
COPY --from=builder --chown=digiid:nodejs /app/.next/standalone ./
COPY --from=builder --chown=digiid:nodejs /app/.next/static ./.next/static

USER digiid
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Lancer le serveur Node.js natif de Next.js standalone
CMD ["node", "server.js"]